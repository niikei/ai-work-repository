// Compatibility for the optional markdownlint VS Code extension.
// rumdl and pyproject.toml remain the canonical Markdown quality gate.
{
  "MD013": false,
  "MD041": false,
  // Obsidian embeds use ![[target]] rather than Markdown image alt text.
  "MD045": false,
  "MD060": {
    "style": "compact"
  }
}
