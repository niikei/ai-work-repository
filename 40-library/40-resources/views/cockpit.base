filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("90-templates")'
formulas:
  record: file.asLink(id)
  inbox_item: file.asLink(file.name)
  project_overdue: if(type == "project" && target_date, target_date < today() && status != "completed" && status != "cancelled", false)
  area_review_overdue: if(type == "area", last_reviewed + if(review_cycle == "weekly", "1w", if(review_cycle == "monthly", "1M", if(review_cycle == "quarterly", "3M", "1y"))) < today(), false)
  resource_stale: if(type == "artifact" && kind == "external-resource", last_verified < today() - "90d", false)
  needs_attention: if(type == "project", status == "blocked" || health == "amber" || health == "red" || priority == "critical" || formula.project_overdue, if(type == "area", health == "unknown" || health == "amber" || health == "red" || formula.area_review_overdue, formula.resource_stale))
  reason: if(type == "project", if(status == "blocked", "Blocked", if(formula.project_overdue, "Target overdue", if(priority == "critical", "Critical priority", if(health == "red", "Red health", "Amber health")))), if(type == "area", if(formula.area_review_overdue, "Review overdue", if(health == "red", "Red health", if(health == "amber", "Amber health", "Unknown health"))), "Verification overdue"))
  signal_date: if(type == "project", target_date, if(type == "area", last_reviewed, last_verified))
  next_review: last_reviewed + if(review_cycle == "weekly", "1w", if(review_cycle == "monthly", "1M", if(review_cycle == "quarterly", "3M", "1y")))
properties:
  formula.record:
    displayName: Record
  formula.inbox_item:
    displayName: Inbox item
  type:
    displayName: Type
  status:
    displayName: Status
  health:
    displayName: Health
  priority:
    displayName: Priority
  owner:
    displayName: Owner
  target_date:
    displayName: Target date
  last_reviewed:
    displayName: Last reviewed
  formula.next_review:
    displayName: Next review
  formula.reason:
    displayName: Reason
  formula.signal_date:
    displayName: Signal date
  date:
    displayName: Date
  file.mtime:
    displayName: Modified
views:
  - type: table
    name: Attention
    filters: formula.needs_attention
    order:
      - formula.record
      - type
      - formula.reason
      - owner
      - formula.signal_date
    sort:
      - property: formula.signal_date
        direction: ASC
    limit: 50
  - type: table
    name: Inbox
    filters: file.inFolder("00-inbox") && file.name != "README"
    order:
      - formula.inbox_item
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 50
  - type: table
    name: Active projects
    filters: type == "project" && status == "active"
    order:
      - formula.record
      - health
      - priority
      - owner
      - target_date
      - updated
    sort:
      - property: target_date
        direction: ASC
    limit: 100
  - type: table
    name: Area reviews
    filters: type == "area" && (health == "unknown" || health == "amber" || health == "red" || formula.area_review_overdue)
    order:
      - formula.record
      - health
      - last_reviewed
      - formula.next_review
      - owner
    sort:
      - property: formula.next_review
        direction: ASC
    limit: 50
  - type: table
    name: Recent activity
    filters: type == "log" && date >= today() - "7d"
    order:
      - formula.record
      - date
      - related
    sort:
      - property: date
        direction: DESC
    limit: 50
