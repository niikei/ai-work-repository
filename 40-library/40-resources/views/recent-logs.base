filters:
  and:
    - file.ext == "md"
    - '!file.inFolder("90-templates")'
    - type == "log"
formulas:
  record: file.asLink(id)
properties:
  formula.record:
    displayName: Log
  date:
    displayName: Date
  updated:
    displayName: Updated
  related:
    displayName: Related
views:
  - type: table
    name: Last 7 days
    filters: date >= today() - "7d"
    sort:
      - property: date
        direction: DESC
    limit: 50
    order:
      - formula.record
      - date
      - related
  - type: table
    name: Last 30 days
    filters: date >= today() - "30d"
    sort:
      - property: date
        direction: DESC
    limit: 100
    order:
      - formula.record
      - date
      - updated
      - related
  - type: table
    name: All logs
    sort:
      - property: date
        direction: DESC
    limit: 500
    order:
      - formula.record
      - date
      - updated
      - related
